# URL do banco de dados (Pooler/PgBouncer do Supabase, porta 6543 - usada pelo app em runtime)
DATABASE_URL="postgresql://postgres.XXXXX:SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres"

# URL de conexão DIRETA do Supabase (porta 5432 - usada pelo Prisma Migrate)
# Necessária porque o pooler (6543) não suporta advisory locks para migrações
DIRECT_DATABASE_URL="postgresql://postgres.XXXXX:SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Porta onde o servidor Express irá rodar
PORT=3333

# Segredo JWT para assinar os tokens de autenticação
JWT_SECRET="insira-um-segredo-longo-e-seguro-aqui"

# Configurações de CORS para produção (separe múltiplos domínios por vírgula)
# Deixe em branco em desenvolvimento para aceitar localhost por padrão
ALLOWED_ORIGINS="https://seu-app-frontend.vercel.app,http://localhost:5173"

# Node Environment
NODE_ENV="production"
